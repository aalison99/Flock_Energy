# Copy to .env and fill in. Never commit .env.
URJA_PORTAL_URL=https://urja-ops.flockenergy.tech
URJA_PORTAL_EMAIL=you@example.com
URJA_PORTAL_PASSWORD=change-me

# Optional (defaults shown)
# URJA_APP_NAME=Urja Meter API
# URJA_ENVIRONMENT=dev
# URJA_LOG_LEVEL=INFO
# URJA_DB_URL=sqlite:///./urja.db
# URJA_DB_MIGRATE_ON_STARTUP=true
# URJA_CORS_ORIGINS=["http://localhost:5173"]
# URJA_HTTP_TIMEOUT_S=10.0
# URJA_RETRY_ATTEMPTS=3
# URJA_RETRY_BASE_DELAY_S=0.25
# URJA_RETRY_MAX_DELAY_S=4.0
# URJA_RETRY_AFTER_CAP_S=30.0
# URJA_BREAKER_FAILURE_THRESHOLD=5
# URJA_BREAKER_RESET_S=30.0
# URJA_TTL_STATIC_S=86400.0
# URJA_TTL_READINGS_S=900.0
# URJA_CACHE_MAX_ENTRIES=10000
# URJA_PORTAL_MAX_RPS=1.5   # measured 4 Nov: ~120 requests/minute is accepted; 4 req/s gets 429 after ~120 requests; 1 req/s for 191 requests is fine
# URJA_SYNC_ON_STARTUP=true
# URJA_SYNC_READINGS_ON_STARTUP=true
# URJA_SYNC_CONCURRENCY=4
