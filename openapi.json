          },
          "meta": {
            "$ref": "#/components/schemas/MetaOut",
            "description": "Provenance and freshness of this answer."
          },
          "meter_id": {
            "description": "Portal meter id, J followed by six digits.",
            "title": "Meter Id",
            "type": "string"
          },
          "phase_type": {
            "$ref": "#/components/schemas/PhaseType",
