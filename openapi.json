          "kvah",
          "power_factor",
          "avg_voltage",
          "readings",
          "flags"
        ],
        "title": "ReadingBucket",
        "type": "object"
      },
      "ReadingPoint": {
        "description": "One portal reading with the consumption over the interval that ends at it.",
        "properties": {
          "at": {
            "description": "When the register was read (IST, ISO 8601 with +05:30).",
            "format": "date-time",
