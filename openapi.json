              }
            ],
            "description": "Code of the feeder it hangs off, if known.",
            "title": "Feeder Code"
          },
          "name": {
            "description": "Transformer display name.",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name",
          "feeder_code",
          "capacity_kva"
        ],
        "title": "TransformerOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Urja Meter API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Ready unless the portal circuit breaker is open; never calls the portal.",
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Not ready: portal breaker open"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/meters": {
      "get": {
        "description": "Paginated meter list, optionally narrowed by a search text on id or serial.",
        "operationId": "listMeters",
        "parameters": [
          {
            "description": "Search text matched against meter id and serial.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search text matched against meter id and serial.",
              "title": "Q"
            }
          },
          {
            "description": "Page number, starting at 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page number, starting at 1.",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page (1 to 200).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Items per page (1 to 200).",
              "maximum": 200,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_MeterSummary_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal auth or protocol failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (present when the portal gave a hint).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "List meters",
        "tags": [
          "meters"
        ]
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "description": "Full meter record with hierarchy, geo position and freshness metadata.",
        "operationId": "getMeter",
        "parameters": [
          {
            "description": "Meter id, J followed by six digits.",
            "in": "path",
            "name": "meter_id",
            "required": true,
            "schema": {
              "description": "Meter id, J followed by six digits.",
              "pattern": "^J\\d{6}$",
              "title": "Meter Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal auth or protocol failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (present when the portal gave a hint).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get a meter",
        "tags": [
          "meters"
        ]
      }
    },
    "/api/v1/meters/{meter_id}/readings": {
      "get": {
        "description": "Consumption per interval (or summed per hour/day) computed from the portal's cumulative registers. The portal holds a fixed snapshot (23-30 Jun 2026); ranges outside it return empty data.",
        "operationId": "getMeterReadings",
        "parameters": [
          {
            "description": "Meter id, J followed by six digits.",
            "in": "path",
            "name": "meter_id",
            "required": true,
            "schema": {
              "description": "Meter id, J followed by six digits.",
              "pattern": "^J\\d{6}$",
              "title": "Meter Id",
              "type": "string"
            }
          },
          {
            "description": "First calendar day (IST, inclusive), YYYY-MM-DD. Default: no lower bound.",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First calendar day (IST, inclusive), YYYY-MM-DD. Default: no lower bound.",
              "title": "Start"
            }
          },
          {
            "description": "Last calendar day (IST, inclusive), YYYY-MM-DD. Default: no upper bound.",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last calendar day (IST, inclusive), YYYY-MM-DD. Default: no upper bound.",
              "title": "End"
            }
          },
          {
            "description": "raw = one point per reading; hourly or daily = summed buckets.",
            "in": "query",
            "name": "resolution",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Resolution",
              "default": "raw",
              "description": "raw = one point per reading; hourly or daily = summed buckets."
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingSeriesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal auth or protocol failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (present when the portal gave a hint).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get a meter's consumption series",
        "tags": [
          "readings"
        ]
      }
    },
    "/api/v1/transformers": {
      "get": {
        "description": "Paginated transformers sorted by code, optionally filtered by feeder.",
        "operationId": "listTransformers",
        "parameters": [
          {
            "description": "Only transformers on this feeder, e.g. F-001.",
            "in": "query",
            "name": "feeder",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^F-\\d{3}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only transformers on this feeder, e.g. F-001.",
              "title": "Feeder"
            }
          },
          {
            "description": "Page number, starting at 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Page number, starting at 1.",
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "description": "Items per page (1 to 200).",
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Items per page (1 to 200).",
              "maximum": 200,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_TransformerOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal auth or protocol failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (present when the portal gave a hint).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "List transformers",
        "tags": [
          "transformers"
        ]
      }
    },
    "/api/v1/transformers/{code}": {
      "get": {
        "description": "One transformer by its code.",
        "operationId": "getTransformer",
        "parameters": [
          {
            "description": "Transformer code, e.g. DT-001.",
            "in": "path",
            "name": "code",
            "required": true,
            "schema": {
              "description": "Transformer code, e.g. DT-001.",
              "pattern": "^DT-\\d{3}$",
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal auth or protocol failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Portal unavailable",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying (present when the portal gave a hint).",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get a transformer",
        "tags": [
          "transformers"
        ]
      }
    }
  }
}
