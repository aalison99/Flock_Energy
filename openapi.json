          },
          "kwh_register": {
            "description": "Cumulative active-energy register (kWh).",
            "title": "Kwh Register",
            "type": "number"
          },
          "power_factor": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
