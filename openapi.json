{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "The inner object of the error envelope.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error code, e.g. not_found.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Extra context; empty when there is none.",
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Human-readable explanation.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The single error shape returned by every failing endpoint.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The error."
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "GeoOut": {
        "description": "A geographic position.",
        "properties": {
          "lat": {
            "description": "Latitude in degrees.",
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "description": "Longitude in degrees.",
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoOut",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness probe payload.",
        "properties": {
          "status": {
            "const": "ok",
            "description": "Always ok while the process is up.",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Application version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HierarchyLevel": {
        "enum": [
          "zone",
          "circle",
          "division",
          "subdivision",
          "substation",
          "feeder",
          "dt"
        ],
        "title": "HierarchyLevel",
        "type": "string"
      },
      "HierarchyNodeOut": {
        "description": "One level of the network hierarchy.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Node code; null when the portal left it blank.",
            "title": "Code"
          },
          "level": {
            "$ref": "#/components/schemas/HierarchyLevel",
            "description": "Hierarchy level."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Node name; null when the portal left it blank.",
            "title": "Name"
          }
        },
        "required": [
          "level",
          "code",
          "name"
        ],
        "title": "HierarchyNodeOut",
        "type": "object"
      },
      "InstallStatus": {
        "enum": [
          "installed",
          "faulty",
          "decommissioned",
          "unknown"
        ],
        "title": "InstallStatus",
        "type": "string"
      },
      "InstallType": {
        "enum": [
          "whole_current",
          "ct_operated",
          "unknown"
        ],
        "title": "InstallType",
        "type": "string"
      },
      "MetaOut": {
        "description": "Provenance and freshness of the answer.",
        "properties": {
          "fetched_at": {
            "description": "When the data was fetched from the portal (UTC).",
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "source": {
            "const": "portal",
            "description": "Where the data came from.",
            "title": "Source",
            "type": "string"
          },
          "stale": {
            "description": "True when the cached data is past its TTL and the portal could not refresh it.",
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "fetched_at",
          "stale"
        ],
        "title": "MetaOut",
        "type": "object"
      },
